;; Task runner for Narcis -- an Eve-based editor, hosted by Jolt.
;;
;; Run these with `jolt <task>`: jolt reads this file as well as
;; deps.edn, so the name bb.edn stays though babashka isn't needed.
;; `jolt tasks` lists everything.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...)
;; -- use (re-pattern "..."), (deref ...) and (fn [x] ...) instead.
{:tasks
 {:requires ([babashka.fs :as fs]
             [clojure.edn :as edn]
             [clojure.string :as str])

  :init
  (do
    (defn eve-pin
      "The Eve git dep declared in deps.edn: {:git/url ... :git/sha ...}.
       The pin of record."
      []
      (get-in (edn/read-string (slurp "deps.edn")) [:deps (quote eve/eve)]))

    (defn gitlibs-dir
      "Jolt's own checkout of the pinned Eve dep, at
       ~/.jolt/gitlibs/<munged-url>/<sha> (the munging is Jolt's:
       :// becomes ___ and / becomes _). If it is not there yet, a
       `jolt path` run makes Jolt resolve the dep, which clones it;
       the checkout is then looked for by sha, in case the munging
       differs."
      []
      (let [pin (eve-pin)
            sha (:git/sha pin)
            munged (str/replace (str/replace (:git/url pin) "://" "___") "/" "_")
            home (System/getProperty "user.home")
            direct (fs/file home ".jolt" "gitlibs" munged sha)]
        (when-not (fs/exists? (fs/file direct "hosts.edn"))
          (shell {:continue true} "jolt" "path"))
        (if (fs/exists? (fs/file direct "hosts.edn"))
          (str direct)
          (first (filter (fn [d] (fs/exists? (fs/file d "hosts.edn")))
                         (fs/glob (fs/file home ".jolt" "gitlibs")
                                  (str "*/" sha)))))))

    (defn eve-dir
      "The Eve tree this app runs on, first match wins: $EVE_RELEASE,
       a sibling ../eve, Jolt's checkout of the Eve git dep pinned in
       deps.edn (the normal case -- nobody checks Eve out by hand),
       ~/cohost-media-app/eve. A tree is known by its hosts.edn."
      []
      (let [valid (fn [d] (when (and d (fs/exists? (fs/file d "hosts.edn"))) d))]
        (or (valid (System/getenv "EVE_RELEASE"))
            (valid "../eve")
            (valid (gitlibs-dir))
            (valid (str (System/getProperty "user.home")
                        "/cohost-media-app/eve")))))

    (defn eve-jolt-cp
      "Eve's Jolt classpath, from the Eve tree's own hosts.edn
       (its :jolt roots after its src) -- the host shape Eve declares,
       read as data. The classpath is composed here rather than taken
       from `jolt -M` because Eve's deps.edn root :paths are its JVM
       adapters, which Jolt cannot load, and Jolt's resolver offers
       no way to select a library's other path set; hosts.edn is
       Eve's own per-host manifest, as Eve's own tasks read it."
      []
      (let [eve (eve-dir)]
        (when-not eve
          (throw (ex-info "No Eve found: the git dep in deps.edn could not be resolved, and no checkout is at EVE_RELEASE or ../eve." {})))
        (let [hosts (edn/read-string (slurp (fs/file eve "hosts.edn")))]
          (str/join ":" (map (fn [r] (str (fs/file eve r)))
                             (cons "src" (:jolt hosts)))))))

    (defn launch
      "Start narcis.launcher with this task's command-line args. With
       no args the launcher's own defaults rule: the store in ./data,
       port 8377, the current directory as the project, no file open
       beyond the ones the store's session already has."
      []
      (apply shell "jolt" "-Scp" (str (eve-jolt-cp) ":src")
             "-m" "narcis.launcher" *command-line-args*)))

  narcis
  {:doc "Launch Narcis: jolt narcis [--dir data] [--port 8377] [--file file.clj] [--project dir]"
   :task (launch)}

  app:run
  {:doc "Launch Narcis, optionally opening a file: jolt app:run [--dir data] [--port 8377] [--file file.clj]"
   :task (launch)}

  app:test
  {:doc "Run the test corpus: jolt app:test"
   :task (shell "jolt" "-Scp" (str (eve-jolt-cp) ":src:test")
                "-m" "narcis.run-all-tests")}}}
